{
    "name": "contao/image",
    "type": "library",
    "description": "Contao image library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Martin Ausw\u00f6ger",
            "homepage": "https://github.com/ausi"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "imagine/imagine": "^1.5.4",
        "symfony/filesystem": "^7.4.18 || ^8.0",
        "ext-xml": "*",
        "ext-fileinfo": "*",
        "contao/imagine-svg": "^1.0.4"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "phpunit/phpunit": "^9.6.37",
        "symfony/phpunit-bridge": "^7.4.18"
    },
    "suggest": {
        "ext-exif": "To support EXIF auto-rotation and preserve copyright metadata"
    },
    "autoload": {
        "psr-4": {
            "Contao\\Image\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contao\\Image\\Tests\\": "tests/"
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "target-directory": "tools",
            "forward-command": false
        }
    },
    "scripts": {
        "all": [
            "@validate-package",
            "@unit-tests",
            "@cs-check",
            "@phpstan",
            "@workflow-lint"
        ],
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check src tests tools/ecs/config --config tools/ecs/config/default.php --fix --ansi",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyze --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check src tests tools/ecs/config --config tools/ecs/config/default.php --ansi",
        "workflow-lint": "actionlint",
        "validate-package": "@composer validate --strict"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    }
}
